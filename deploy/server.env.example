# Run node scripts/setup-local.mjs to create .env.local with random local secrets.
# Never commit .env.local. Docker build excludes it.
DOMAIN=localhost
PUBLIC_ORIGIN=http://localhost:3000
REPO_ANTI_ROT_DASHBOARD_URL=http://localhost:3000
REPO_ANTI_ROT_PUBLIC=true
REPO_ANTI_ROT_OWNER_TOKEN=GENERATE_SECRET
REPO_ANTI_ROT_SESSION_SECRET=GENERATE_SECRET
REPO_ANTI_ROT_INGEST_TOKEN=GENERATE_SECRET
REPO_ANTI_ROT_READ_TOKEN=GENERATE_SECRET
REPO_ANTI_ROT_AI_PROXY_TOKEN=GENERATE_SECRET
CRON_SECRET=GENERATE_SECRET

# Public repository API access. A token with no private-repository permissions is sufficient.
GITHUB_TOKEN=
# Optional GitHub OAuth App for sign-in. Callback: <PUBLIC_ORIGIN>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional hosted AI triage. Model must be an exact OpenRouter model id.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_ALLOWED_MODELS=
REPO_ANTI_ROT_AI_PUBLIC=false
REPO_ANTI_ROT_AI_DAILY_REQUESTS=100

# Optional email notifications. Use a verified sending domain in RESEND_FROM.
RESEND_API_KEY=
RESEND_FROM=
WATCH_MIN_DROP=3
WATCH_CRON_BATCH=5

# Starting budget for a mini-server; adjust after observing real scans.
REPO_ANTI_ROT_SCAN_CONCURRENCY=3
REPO_ANTI_ROT_SCAN_HEAP_MB=1024
REPO_ANTI_ROT_SCAN_PER_WINDOW=10
REPO_ANTI_ROT_SCAN_MAX_URLS=3
REPO_ANTI_ROT_SCAN_QUEUE=20
REPO_ANTI_ROT_SCAN_QUEUE_WAIT_S=120
REPO_ANTI_ROT_TRUSTED_PROXY_HOPS=1
REPO_ANTI_ROT_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# Optional: leave blank when using the Docker persistent volume.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
