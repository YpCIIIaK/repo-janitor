{
  "name": "repo-anti-rot",
  "version": "0.2.0",
  "description": "Repository health & decay monitor — scans a codebase for committed secrets, vulnerable/abandoned dependencies, dead code, stale branches, aging TODOs and more, then scores it A–F. Emits terminal, JSON, Markdown or SARIF.",
  "type": "module",
  "license": "MIT",
  "author": "YpCIIIaK",
  "homepage": "https://github.com/YpCIIIaK/repo-janitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YpCIIIaK/repo-janitor.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/YpCIIIaK/repo-janitor/issues"
  },
  "keywords": [
    "cli",
    "repository",
    "health",
    "code-quality",
    "secrets",
    "sarif",
    "vulnerabilities",
    "osv",
    "dependencies",
    "dead-code",
    "technical-debt",
    "linter",
    "static-analysis"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "repo-anti-rot": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:fast": "tsup --format esm --no-dts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "simple-git": "^3.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@repo-anti-rot/core": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  }
}
