# --- dependencies ---
node_modules/

# --- build output ---
.next/
out/
dist/
# ...except the Action's bundle. A GitHub Action runs straight from the
# repository at the tagged ref, with no install step and no node_modules, so
# `packages/action/dist/index.cjs` has to be committed or `uses:` resolves to a
# file that is not there. CI rebuilds it and fails if it differs from source.
!packages/action/dist/
!packages/action/dist/index.cjs
build/
*.tsbuildinfo
next-env.d.ts

# --- logs ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- scan artifacts (generated locally by the dashboard / CLI) ---
.repo-anti-rot/
.reporot/
# anchored: only the repo-root output dir, never e.g. app/api/reports/
/reports/
real-report.json
dogfood-scan.json
*.repo-anti-rot.json
# ...but the per-project CONFIG file is meant to be committed
!.repo-anti-rot.json

# --- internal, not for the public repo ---
# PLAN.md is product/commercial reasoning; ROADMAP.md tracked internal sequencing.
# Both live on locally and in history — untracking them only stops new changes.
PLAN.md
ROADMAP.md
# Local scanner fixture, never a deliverable.
sample-repo/

# --- environment / secrets ---
.env
.env.*
!.env.example

# --- editor / OS / tooling ---
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- v0 sandbox internal files ---
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/
