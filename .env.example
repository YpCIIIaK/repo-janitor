# Repo Anti-Rot — dashboard environment.
#
# Every variable here is OPTIONAL: with none set the app runs, scans and serves
# the dashboard. They exist to lock things down and to enable the paid-for extras.
# Copy to `.env.local` for local use, or paste into your host's env settings.
#
# One rule worth reading before deploying publicly: the defaults are tuned for a
# laptop, not for the open internet. The scan limits below are the ones to change.

# ---------------------------------------------------------------------------
# Public scan limits  (lib/scan-limits.ts)
# ---------------------------------------------------------------------------
# /api/scan clones and scans arbitrary repositories on your machine — minutes of
# CPU and hundreds of MB of IO per request. These bound the damage.
#
# NOTE: the limiter keeps state in process memory. Run more than one instance and
# each gets its own budget, so the effective limit multiplies by instance count.

# Scans allowed per client per window.
REPO_ANTI_ROT_SCAN_PER_WINDOW=30
# Length of that window, in seconds.
REPO_ANTI_ROT_SCAN_WINDOW_S=3600
# Repositories cloned+scanned at once, process-wide. This is the setting that
# actually protects CPU, memory and disk — lower it on a small instance.
REPO_ANTI_ROT_SCAN_CONCURRENCY=2
# Callers allowed to wait for a slot before requests are refused outright.
REPO_ANTI_ROT_SCAN_QUEUE=10
# How long a caller may wait for a slot before giving up, in seconds.
REPO_ANTI_ROT_SCAN_QUEUE_WAIT_S=60
# URLs accepted per request. Set to 1 for a public single-repo diagnostic.
REPO_ANTI_ROT_SCAN_MAX_URLS=20
# Proxy hops you control, for reading x-forwarded-for. Almost every PaaS puts
# exactly one proxy in front, so 1 is right. Raise it ONLY if you added your own
# proxy/CDN in front of that — too high a value trusts a forged client address.
REPO_ANTI_ROT_TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Share-link storage  (lib/share-store.ts)  — optional but strongly advised
# ---------------------------------------------------------------------------
# With these unset, share links are written to the container filesystem. That is
# fine locally and WRONG on most hosts: a container disk is ephemeral, and on
# Render's free tier there is no persistent disk at all, so a redeploy silently
# breaks every link anyone has already posted. Configure these before announcing
# anything publicly.
#
# Run once in the Supabase SQL editor:
#
#   create table public.shared_reports (
#     token       text primary key,
#     created_at  timestamptz not null default now(),
#     report      jsonb not null
#   );
#   alter table public.shared_reports enable row level security;
#
# Add no RLS policies. With none, the anon and authenticated roles can do
# nothing, and only the service role below — which bypasses RLS and never leaves
# the server — can read or write. The share token is the capability; the database
# is not meant to be a second, weaker gate.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service role key (Settings → API → service_role). This bypasses row-level
# security: it is a server secret. Never expose it to the browser, never prefix
# it with NEXT_PUBLIC_, and rotate it if it ever lands in a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# API auth
# ---------------------------------------------------------------------------
# Shared secrets for the CI → dashboard loop. Unset means the endpoint is open,
# which is fine locally and wrong on a public host.

# Required as `Authorization: Bearer <token>` to POST a report to /api/ingest.
# Set the same value as the GitHub Action's `dashboard-token` input.
REPO_ANTI_ROT_INGEST_TOKEN=
# Required to GET /api/reports. Separate from the ingest token on purpose:
# writing reports and reading everyone's reports are different privileges.
REPO_ANTI_ROT_READ_TOKEN=

# ---------------------------------------------------------------------------
# AI layer  (app/api/ai/complete)  — optional
# ---------------------------------------------------------------------------
# Without these the dashboard still works; users can paste their own OpenRouter
# key in Settings and pay for their own usage.

# A shared server-side key, so visitors get AI features without pasting one.
# THIS SPENDS YOUR CREDITS.
OPENROUTER_API_KEY=
# Required whenever OPENROUTER_API_KEY is set. Callers must send it as
# `Authorization: Bearer <token>` to use the shared key. Without it the route
# returns 503 rather than letting anonymous visitors spend your balance —
# set both or neither.
REPO_ANTI_ROT_AI_PROXY_TOKEN=
# Comma-separated allowlist for the shared key, e.g.
# "anthropic/claude-3.5-haiku,openai/gpt-4o-mini". Empty means any model, which
# also means any price.
OPENROUTER_ALLOWED_MODELS=

# ---------------------------------------------------------------------------
# Score-drop alerts  (lib/webhook.ts)  — optional
# ---------------------------------------------------------------------------
# Fired from /api/ingest when a repo's score falls versus the previous scan.

# Incoming webhook URL (Slack, Discord, Mattermost — anything taking {"text": …}).
REPO_ANTI_ROT_WEBHOOK_URL=
# Minimum score drop before alerting. 1 = any drop at all.
REPO_ANTI_ROT_WEBHOOK_MIN_DROP=1
# Public dashboard URL, appended to the alert so the link is clickable.
REPO_ANTI_ROT_DASHBOARD_URL=

# ---------------------------------------------------------------------------
# Deprecated spellings
# ---------------------------------------------------------------------------
# The four variables above once used a `RAR_` prefix — RAR_AI_PROXY_TOKEN,
# RAR_WEBHOOK_URL, RAR_WEBHOOK_MIN_DROP, RAR_DASHBOARD_URL. Two prefixes for one
# project meant you had to read the source to know which applied where.
#
# The old names still resolve (lib/env.ts) and there is no rush to change them.
# They are only read when the new name is unset, so setting both is safe.
